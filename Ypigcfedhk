-- สร้างปุ่มฟังก์ชัน
for _, func in ipairs(Functions) do
    Enabled[func.Key] = false
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, -12, 0, 42)
    Btn.BackgroundColor3 = Color3.fromRGB(60, 30, 10)
    Btn.Text = func.ID..". "..func.Emoji.." "..func.Name.." — ❌ ปิด"
    Btn.TextColor3 = Color3.fromRGB(255, 180, 80)
    Btn.TextSize = 14
    Btn.Font = Enum.Font.GothamMedium
    Btn.AutoLocalize = false
    Btn.Parent = Scroll
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 10)

    Btn.MouseButton1Click:Connect(function()
        Enabled[func.Key] = not Enabled[func.Key]
        local status = Enabled[func.Key] and "✅ เปิด" or "❌ ปิด"
        Btn.Text = func.ID..". "..func.Emoji.." "..func.Name.." — "..status
        Btn.BackgroundColor3 = Enabled[func.Key] and Color3.fromRGB(255, 100, 0) or Color3.fromRGB(60, 30, 10)
    end)
end

